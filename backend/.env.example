# Frontend site origin used for CORS and patient-facing email links (not NEXT_PUBLIC_API_URL).
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
CLERK_PUBLISHABLE_KEY=pk_test_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
APPLICATION_TIMEZONE=Asia/Kolkata

BREVO_API_KEY=replace_with_brevo_api_key
BREVO_SENDER_EMAIL=replace_with_verified_sender_email
BREVO_SENDER_NAME=Medrella

SMS_PROVIDER=mock

REMINDER_CRON_SECRET=replace_with_a_random_secret_at_least_32_characters
NOTIFICATION_RECOVERY_CRON_SECRET=replace_with_a_different_random_secret_at_least_32_characters

STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
